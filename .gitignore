# --- Python
__pycache__/
*.py[cod]

# --- OS/IDE
.DS_Store
.vscode/

# --- Run-Status, Logs, Working dirs
runs/
logs/
job.errs.outs/
**/*.log
**/.snakemake/
**/.snakemake/*

# --- Lokale Konfiguration
config/local.yaml

# --- Umgebungen (nicht versionieren)
micromamba/
.mamba/
.conda/
*_snk_binny_persist*/

# --- Referenzdaten komplett ignorieren (bei Bedarf gezielt whitelisten)
refdata/

# --- SRA: große Daten & Outputs ignorieren, aber Metadateien behalten
SRA/raw_fastq/
SRA/raw_fasta/
SRA/testsets/
SRA/qc/
SRA/assemblies/
SRA/binning/
SRA/mags/
SRA/plasmids/
SRA/viruses/
SRA/args/
SRA/taxonomy/
SRA/.state/

# Behalte README/Manifeste in SRA (falls vorhanden)
!SRA/**/README.md
!SRA/**/README.txt
!SRA/**/manifest.tsv
!SRA/**/samples.tsv

# --- Binny/MANTIS spezifisch
SRA/**/binny/**/intermediary/
SRA/**/binny/**/bins/

external/binny/database/hmms/**/chunks/
external/binny/database/hmms/**/metadata.db
external/binny/database/hmms/**/checkm_filtered_*.hmm.h3*
external/binny/database/hmms/**/checkm_filtered_*.ssi

# Behalte kleine, benötigte DB-Assets
!external/binny/database/support/Resources/Taxonomy.db

# --- Sonstiges (falls versehentlich hinzugefügt)
envs/*/env.lock
